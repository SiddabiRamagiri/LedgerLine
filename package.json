{
  "name": "ledgerline",
  "version": "1.0.0",
  "private": true,
  "description": "LedgerLine foundation for the Snovasys Fresher Hiring Challenge 2026",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
