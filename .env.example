NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:change_me@localhost:5432/ledgerline_db
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
# Optional for local migrations. Production migrations require a distinct direct URL and role.
MIGRATION_DATABASE_URL=
JWT_SECRET=replace_with_at_least_32_random_bytes
JWT_EXPIRES_IN=1h
LOGIN_RATE_WINDOW_MS=900000
LOGIN_RATE_LIMIT=10
